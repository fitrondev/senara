{
  "name": "@senara/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "env:generate": "bun --bun varlock codegen",
    "db:push": "bun --bun prisma db push",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:migrate:deploy": "bun --bun prisma migrate deploy",
    "db:studio": "bun --bun prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@senara/config": "workspace:*",
    "prisma": "^7.10.0",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
